# AI Comprehension Test - Environment example

# Local AI agent command (e.g., claude, codex, custom)
AI_COMP_TEST_COMMAND=claude

# Arguments for the agent command (space-separated)
# For Claude CLI: -p
# For Codex CLI: exec
AI_COMP_TEST_ARGS=-p

# Timeout for AI calls in seconds
AI_COMP_TEST_TIMEOUT=180

# Optional working directory for the agent process
# If unset, current working directory is used
# AI_COMP_TEST_WORKDIR=/absolute/path/to/workdir

# Optional: verbose debug logs (currently not used by code)
# AI_COMP_TEST_DEBUG=false

# Stability scoring mode
# Default (unset or 'tfidf') uses TF‑IDF + cosine per field.
# Set to 'embedding' to use sentence embeddings via @xenova/transformers.
# AI_COMP_TEST_STABILITY_MODE=tfidf

# Embedding model (only used when AI_COMP_TEST_STABILITY_MODE=embedding)
# Default: Xenova/all-mpnet-base-v2 (higher accuracy; heavier)
# Lighter alternative: Xenova/all-MiniLM-L6-v2 (smaller/faster)
# AI_COMP_TEST_EMBED_MODEL=Xenova/all-mpnet-base-v2
